# Base defaults for the shared dev profile.
# Optional local overrides live in `.env.dev.local` and are ignored by Git.
EXPO_PUBLIC_APP_PROFILE=dev
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.105:8081

# No celular físico, use o IP do computador com a porta da API (8080).
# Execute no terminal: npm run start:dev -- -- start --web
