{
  "name": "unify-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:dev": "node scripts/start-expo-profile.js dev",
    "start:dev-avd-localhost": "node scripts/start-expo-profile.js dev-avd-localhost",
    "start:homolog": "node scripts/start-expo-profile.js homolog",
    "start:prod": "node scripts/start-expo-profile.js prod",
    "android:local": "node scripts/start-expo-profile.js dev-avd-localhost --android-local",
    "android:local:dev": "node scripts/start-expo-profile.js dev --android-local",
    "android:local:dev-avd-localhost": "node scripts/start-expo-profile.js dev-avd-localhost --android-local",
    "android:local:homolog": "node scripts/start-expo-profile.js homolog --android-local",
    "android:local:prod": "node scripts/start-expo-profile.js prod --android-local",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "private": true
}
