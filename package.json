{
  "name": "unify-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:dev": "node scripts/start-expo-profile.js dev",
    "start:dev-avd-localhost": "node scripts/start-expo-profile.js dev-avd-localhost",
    "start:homolog": "node scripts/start-expo-profile.js homolog",
    "start:prod": "node scripts/start-expo-profile.js prod",
    "android:local": "node scripts/start-expo-profile.js dev-avd-localhost --android-local",
    "android:local:dev": "node scripts/start-expo-profile.js dev --android-local",
    "android:local:dev-avd-localhost": "node scripts/start-expo-profile.js dev-avd-localhost --android-local",
    "android:local:homolog": "node scripts/start-expo-profile.js homolog --android-local",
    "android:local:prod": "node scripts/start-expo-profile.js prod --android-local",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.0",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "private": true
}
